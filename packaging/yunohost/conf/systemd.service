[Unit]
Description=ChaptarrNG audiobook library service
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/bin
Environment="DOTNET_ROOT=/usr/share/dotnet"
Environment="DOTNET_CLI_TELEMETRY_OPTOUT=1"
Environment="Chaptarr__Server__BindAddress=127.0.0.1"
Environment="Chaptarr__Server__Port=__PORT__"
Environment="Chaptarr__Update__Mechanism=External"
Environment="Chaptarr__Update__Automatically=false"
Environment="PATH=__INSTALL_DIR__/tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TMPDIR=__DATA_DIR__/tmp"
ExecStart=/usr/bin/dotnet __INSTALL_DIR__/bin/Chaptarr.dll -nobrowser -data=__DATA_DIR__
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__APP__
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
