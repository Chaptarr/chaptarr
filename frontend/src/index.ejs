<!DOCTYPE html>
<html lang="en">
  <!-- Build: <%= cacheBuster %> -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <!-- Chrome, Opera, and Firefox OS -->
    <meta name="theme-color" content="#3a3f51" />
    <!-- Windows Phone -->
    <meta name="msapplication-navbutton-color" content="#3a3f51" />
    <!-- Android/Apple Phone -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no">

    <meta name="description" content="Chaptarr">

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/Content/Images/Icons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/Content/Images/Icons/favicon.svg"
    />
    <link rel="manifest" href="/Content/Images/Icons/manifest.json" crossorigin="use-credentials" />
    <link
      rel="mask-icon"
      href="/Content/Images/Icons/safari-pinned-tab.svg"
      color="#7d1b1b"
    />
    <meta
      name="msapplication-config"
      content="/Content/Images/Icons/browserconfig.xml"
    />

    <link rel="stylesheet" type="text/css" href="/Content/Fonts/fonts.css">

    <script>
      window.Chaptarr = {
        urlBase: '__URL_BASE__'
      };
      
    </script>

    <% const bundledAssetOrigin = 'https://chaptarr.invalid'; %>
    <% const safeAssetSource = (asset) => {
      if (typeof asset !== 'string' || asset.length === 0 || asset.length > 2048) {
        throw new Error('Invalid bundled asset URL');
      }
      let parsed;
      try {
        parsed = new URL(asset, `${bundledAssetOrigin}/`);
      } catch {
        throw new Error('Invalid bundled asset URL');
      }
      if (parsed.origin !== bundledAssetOrigin) {
        throw new Error('Bundled assets must use a same-origin URL');
      }
      return `${parsed.pathname}${parsed.search}${parsed.hash}`;
    }; %>
    <% for (const scriptSource of htmlWebpackPlugin.files.js) { %><script type="text/javascript" src="<%= safeAssetSource(scriptSource) /* nosemgrep: javascript.express.security.audit.xss.ejs.var-in-script-src.var-in-script-src -- safeAssetSource accepts only same-origin build asset URLs and returns a normalized path. */ %>" data-no-hash></script><% } %>
    <% for (const stylesheetSource of htmlWebpackPlugin.files.css) { %><link href="<%= safeAssetSource(stylesheetSource) %>" rel="stylesheet"></link><% } %>

    <title>Chaptarr</title>

    <!--
      The super basic styling for .root  will live here,
      saves fighting with CSS Modules for ~10 lines
    -->
    <style>
      .root {
        overflow: hidden;
        height: 100%; /* needed for proper layout */
      }

      @media only screen and (max-width: 768px) {
        .root {
          display: flex;
          flex-direction: column;
          min-height: 100%;
          height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div id="portal-root"></div>
    <div id="root" class="root"></div>
  </body>
</html>
