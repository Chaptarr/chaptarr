{
  "compilerOptions": {
      "target": "esnext",
      "allowJs": true,
      "checkJs": false,
      "strict": false,
      "skipLibCheck": true,
      "jsx": "react",
      "module": "esnext",
      "moduleResolution": "bundler",
      "noEmit": true,
      "esModuleInterop": true,
      "types": ["node"],
      "typeRoots": ["../node_modules/@types", "./typings"],
      "paths": {
          "*": [
              "./src/*"
          ]
      },
      "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": [
      "./src/**/*",
      "./typings/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "./src/sw.js"
  ]
}
