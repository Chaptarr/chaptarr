# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set bash scripts to have unix endings
*.sh text eol=lf
distribution/osx/Chaptarr text eol=lf

# Immutable predecessor catalogs retain their recorded source-byte hashes.
src/NzbDrone.Core/Localization/BookshelfCompatibility/*.json -text

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union
