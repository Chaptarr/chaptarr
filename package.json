{
  "name": "chaptarrng",
  "version": "0.9.983",
  "description": "ChaptarrNG, the SeerrNG-maintained Chaptarr fork",
  "scripts": {
    "release-notes:preview": "node scripts/preview-release-notes.mjs",
    "build": "webpack --env production --config ./frontend/build/webpack.config.js",
    "prebuild": "yarn clean",
    "clean": "npx rimraf ./_output/UI && npx rimraf --glob \"**/*.js.map\"",
    "start": "webpack --watch --config ./frontend/build/webpack.config.js",
    "watch": "webpack --watch --config ./frontend/build/webpack.config.js",
    "typecheck": "tsc -p frontend/tsconfig.json && tsc -p frontend/tsconfig.sw.json",
    "lint": "eslint --config frontend/.eslintrc.js --ignore-path frontend/.eslintignore frontend/",
    "check-direct-download": "node frontend/build/check-direct-download-contract.js",
    "check-react-router-context": "node scripts/check-react-router-context.cjs",
    "lint-fix": "yarn lint --fix",
    "check-translations": "node frontend/build/check-missing-translation-keys.js",
    "analyze": "ANALYZER=true webpack --env production --config ./frontend/build/webpack.config.js",
    "stylelint-linux": "stylelint $(find frontend -name '*.css') --config frontend/.stylelintrc",
    "stylelint-windows": "stylelint \"frontend/**/*.css\" --config frontend/.stylelintrc",
    "check-localization": "node frontend/build/check-localization-catalogs.js",
    "test-localization": "node --test frontend/build/source-equality-audit.test.cjs frontend/src/Utilities/Localization/formatters.test.cjs frontend/src/Utilities/Localization/locale-utils.test.cjs frontend/src/Utilities/Localization/message-formatting.test.cjs frontend/build/postcss-logical-direction.test.cjs frontend/src/Utilities/Localization/server-message-match.test.cjs frontend/build/check-server-message-catalogs.test.cjs frontend/build/check-localized-source-coverage.test.cjs frontend/src/Settings/ImportLists/ImportLists/ImportListSyncModal.test.cjs frontend/src/Utilities/Localization/server-message-presentation.test.cjs frontend/src/Utilities/Localization/scheduled-task-labels.test.cjs frontend/build/followup-source-wiring.test.cjs",
    "localization:update-source-hashes": "node frontend/build/check-localization-catalogs.js --write-source-hashes",
    "localization:update-status": "node frontend/build/check-localization-catalogs.js --write-report",
    "check-localization-sources": "node frontend/build/check-server-message-catalogs.cjs && node frontend/build/check-localized-source-coverage.cjs"
  },
  "sideEffects": [
    "**/*.css",
    "frontend/src/polyfills.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snapetech-org/chaptarrng.git"
  },
  "author": "Snapetech and SeerrNG contributors",
  "license": "GPL-3.0-only",
  "readmeFilename": "readme.md",
  "main": "frontend/src/index.ts",
  "browserslist": [
    "defaults"
  ],
